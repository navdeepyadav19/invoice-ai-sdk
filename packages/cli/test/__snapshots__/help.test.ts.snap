exports[`--help > invoice-ai webhooks --help 1`] = `
"Usage: invoice-ai webhooks [options] [command]

Manage webhook endpoints and test your receiver

Options:
  -h, --help            show help

Global Options:
  -v, --version         print the CLI version
  --api-key <key>       API key to use (overrides INVOICE_AI_API_KEY and the
