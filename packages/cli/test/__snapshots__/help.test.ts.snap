exports[`--help > invoice-ai prices create --help 1`] = `
"Usage: invoice-ai prices create [options]

Create a price for a product

Options:
  --product <id>         the product this price belongs to
  --amount <decimal>     amount in major units, e.g. 25.00 (converted using the
                         currency)
  --unit-amount <minor>  amount in minor units, e.g. 2500 for $25.00
  --currency <code>      ISO 4217 code, e.g. USD
  --nickname <text>      label shown in the dashboard
  --interval <interval>  makes it recurring: day, week, month or year
  --interval-count <n>   intervals between bills (default 1)
  --tax-rate <percent>   default tax percentage for lines billed from this price
  -d, --data <json>      request body as JSON, @file.json or @- for stdin (flags
                         override its fields)
  -h, --help             show help

Global Options:
  -v, --version          print the CLI version
  --api-key <key>        API key to use (overrides INVOICE_AI_API_KEY and the
                         saved profile)
  -p, --profile <name>   saved profile to use (see \`invoice-ai switch\`)
  --json                 print raw JSON (default when output is piped)
  --format <format>      output format (choices: "table", "json", "csv")
  -y, --yes              skip confirmation prompts
  --debug                log each API request and retry (secrets redacted)
  --no-color             disable colors (also honours NO_COLOR)

Example:
  $ invoice-ai prices create --product prod_123 --amount 25.00 --currency USD
"
`;

exports[`--help > invoice-ai prices update --help 1`] = `
"Usage: invoice-ai prices update [options] <id>

Update a price (nickname, default tax rate)

Options:
  --nickname <text>     label shown in the dashboard ("" clears it)
  --tax-rate <percent>  default tax percentage for new lines billed from this
                        price
  -d, --data <json>     request body as JSON, @file.json or @- for stdin (flags
                        override its fields)
  -h, --help            show help

Global Options:
  -v, --version         print the CLI version
  --api-key <key>       API key to use (overrides INVOICE_AI_API_KEY and the
                        saved profile)
  -p, --profile <name>  saved profile to use (see \`invoice-ai switch\`)
  --json                print raw JSON (default when output is piped)
  --format <format>     output format (choices: "table", "json", "csv")
  -y, --yes             skip confirmation prompts
  --debug               log each API request and retry (secrets redacted)
  --no-color            disable colors (also honours NO_COLOR)

Amount, currency and interval changes go through --data. The product can't change;
create a new price instead.

Example:
  $ invoice-ai prices update price_123 --nickname "Annual" --tax-rate 18
"
`;

exports[`--help > invoice-ai products --help 1`] = `
"Usage: invoice-ai products [options] [command]

Manage products in your catalog

Options:
  -h, --help             show help

Global Options:
  -v, --version          print the CLI version
  --api-key <key>        API key to use (overrides INVOICE_AI_API_KEY and the
