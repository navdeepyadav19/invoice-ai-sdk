exports[`--help > invoice-ai invoices --help 1`] = `
"Usage: invoice-ai invoices [options] [command]

Create, send and manage invoices

Options:
  -h, --help             show help

Global Options:
  -v, --version          print the CLI version
  --api-key <key>        API key to use (overrides INVOICE_AI_API_KEY and the
                         saved profile)
  -p, --profile <name>   saved profile to use (see \`invoice-ai switch\`)
  --json                 print raw JSON (default when output is piped)
  --format <format>      output format (choices: "table", "json", "csv")
  -y, --yes              skip confirmation prompts
  --debug                log each API request and retry (secrets redacted)
  --no-color             disable colors (also honours NO_COLOR)

Commands:
  list [options]         List invoices, newest first
  get <id>               Show one invoice with its totals
  create [options]       Create an invoice: a guided wizard with no flags, or
                         scripted with flags
  update [options] <id>  Update a draft invoice (only the fields you pass
                         change)
  delete <id>            Delete a draft invoice (finalized invoices can only be
                         voided)
  finalize <id>          Finalize a draft: assigns the number and locks the
                         lines
  send [options] <id>    Email the invoice to the customer (finalizes a draft
                         first)
  pay [options] <id>     Record a payment received outside Invoice-AI (marks it
                         paid)
  void [options] <id>    Void a finalized invoice (it stays on record, marked
                         void)
  pdf [options] <id>     Download the invoice PDF
  events [options] <id>  Show an invoice's history (created, emailed, viewed,
                         paid…)
"
`;

exports[`--help > invoice-ai invoices create --help 1`] = `
"Usage: invoice-ai invoices create [options]

Create an invoice: a guided wizard with no flags, or scripted with flags

Options:
  --finalize                    finalize it right away (assigns a number, locks
                                the lines)
  --send                        finalize and email it to the customer
  --no-interactive              never start the wizard
  --customer <id>               customer to bill (cus_…)
  --price <id>                  add a line from this price (repeatable)
  --qty <n>                     quantity for the --price in the same position
                                (repeatable, default 1)
  --currency <code>             invoice currency (defaults to your business
                                currency)
  --due-date <YYYY-MM-DD>       due date
  --days-until-due <n>          due this many days after finalizing
  --description <text>          memo shown on the invoice
  --footer <text>               footer text
  --collection-method <method>  send_invoice (default) or charge_automatically
  -d, --data <json>             request body as JSON, @file.json or @- for stdin
                                (flags override its fields)
  -h, --help                    show help

Global Options:
  -v, --version                 print the CLI version
  --api-key <key>               API key to use (overrides INVOICE_AI_API_KEY and
                                the saved profile)
  -p, --profile <name>          saved profile to use (see \`invoice-ai switch\`)
  --json                        print raw JSON (default when output is piped)
  --format <format>             output format (choices: "table", "json", "csv")
  -y, --yes                     skip confirmation prompts
  --debug                       log each API request and retry (secrets
                                redacted)
  --no-color                    disable colors (also honours NO_COLOR)

Examples:
  $ invoice-ai invoices create                      # guided wizard
  $ invoice-ai invoices create --customer cus_123 --price price_abc --qty 2 --send
"
`;

