exports[`--help > invoice-ai prices --help 1`] = `
"Usage: invoice-ai prices [options] [command]

Manage prices (what a product costs, per currency)

Options:
  -h, --help             show help

Global Options:
  -v, --version          print the CLI version
  --api-key <key>        API key to use (overrides INVOICE_AI_API_KEY and the
